{
  "name": "monitoring-admin-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --success first \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "test": "node --test",
    "db:seed": "node server/seed.js",
    "db:seed-users": "node server/seed-users.js",
    "preview": "vite preview",
    "start": "node server/index.js",
    "express": "nodemon --watch server server/index.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "pg": "^8.13.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.0.6",
    "vite": "^6.1.0"
  }
}
